# Copy to .env and fill in to use the real Claude API for the dialogue gate.
# If left unset, the backend uses a deterministic offline stub (still fully playable).
ANTHROPIC_API_KEY=

# Encrypts TOTP secrets at rest (any strong random string). If unset, a known
# dev key is used and the API logs a warning — set this for anything real.
ONELIFE_SECRET_KEY=

# Comma-separated emails allowed to use the hidden admin export/import UI.
# The logged-in account's email must be in this list to see the ⚙ admin panel.
ONELIFE_ADMIN_EMAILS=

# Optional — enables real Spotify track resolution (search, 30s previews, album art)
# AND the Web Playback SDK connect flow (full tracks; client id alone is enough
# for the SDK, secret is for server-side search). Create an app at
# developer.spotify.com and register http://localhost:5173/ as a redirect URI.
# Without these, the game still suggests fitting tracks as text (no playback).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# The exact redirect URI you registered in the Spotify dashboard. Must match the
# browser origin where you open the game. Examples:
#   http://localhost:5173/      (if Spotify accepts localhost)
#   http://127.0.0.1:5173/      (if it requires a loopback IP — then open the game at 127.0.0.1)
# Leave empty to use the app's own origin + path automatically.
SPOTIFY_REDIRECT_URI=

# Optional — real location images. Pick a provider:
#   IMAGE_PROVIDER=pollinations  free + keyless (https://pollinations.ai) — no key needed.
#   IMAGE_PROVIDER=openai        OpenAI-compatible images API — needs IMAGE_API_KEY below.
# Unset / neither configured -> procedural SVG banner per theme.
# After enabling, warm the cache: docker compose run --rm api python -m app.gen_images
IMAGE_PROVIDER=openai
IMAGE_API_KEY=
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
# Pollinations options (only used when IMAGE_PROVIDER=pollinations).
POLLINATIONS_MODEL=flux
IMAGE_BANNER_SIZE=1024x384
# Optional token from auth.pollinations.ai. With it, locations that have a real
# reference photo are generated image-to-image (the real place, restyled) instead
# of text-to-image. Without it, everything is text-to-image of the named place.
POLLINATIONS_TOKEN=
POLLINATIONS_EDIT_MODEL=kontext
