# Host path to the game-data folder, mounted into the API at /content. The engine is
# data-agnostic; this selects which dataset to run. Default: the in-repo Sandby Mystery.
GAME_DATA_DIR=./games/SandbyMystery/data

# ── Public deployment (only needed for the production overlay) ───────────────────
# docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# Caddy terminates HTTPS for this domain and proxies one origin to the api + web.
# Point DOMAIN's DNS at this host's public IP (DuckDNS works for a dynamic IP) and
# forward router TCP 80 + 443 here. Then register https://DOMAIN/ as the Spotify
# redirect URI. Leave these blank for local-only development.
DOMAIN=
# CORS allow-list (comma-separated). For the production overlay set this to your
# https origin, e.g. https://DOMAIN. Unset -> defaults to localhost:5173 for dev.
WEB_ORIGIN=
# DuckDNS dynamic-DNS updater (only if DOMAIN is a *.duckdns.org name). The overlay's
# `duckdns` service keeps the record pointed at this host's public IP. SUBDOMAINS is
# the label(s) WITHOUT ".duckdns.org" (so for DOMAIN=erbserver.duckdns.org, use
# erbserver); TOKEN is your account token from https://www.duckdns.org. Leave blank
# if you manage DNS elsewhere (the duckdns container will just idle/no-op).
DUCKDNS_SUBDOMAINS=
DUCKDNS_TOKEN=

# LLM provider. Unset = "anthropic" if ANTHROPIC_API_KEY is set, else "stub".
#   anthropic — real Claude API, server-side.
#   browser   — the model runs IN THE PLAYER'S BROWSER via WebGPU (WebLLM). No key or
#               server GPU needed; each player downloads the model once. Gate verdicts
#               become client-trusted (fine for a personal/trusted deployment).
#   stub      — deterministic offline keyword heuristics.
LLM_PROVIDER=
# WebLLM model id — browser mode only. A prebuilt MLC model; bigger = better structured
# output but larger download. e.g. Qwen2.5-7B-Instruct-q4f16_1-MLC. Ignored otherwise.
LLM_MODEL=Llama-3.2-3B-Instruct-q4f16_1-MLC
# Claude models — anthropic mode only. The Actor writes the in-character dialogue, so it
# carries the prose quality; the Referee only returns a small typed verdict against the
# authored criteria, so it can be a cheaper model. Both default to claude-haiku-4-5.
ACTOR_MODEL=claude-sonnet-5
REFEREE_MODEL=claude-haiku-4-5

# Copy to .env and fill in to use the real Claude API for the dialogue gate (the
# "anthropic" provider). If left unset, the backend uses a deterministic offline stub.
ANTHROPIC_API_KEY=

# Encrypts TOTP secrets at rest (any strong random string). If unset, a known
# dev key is used and the API logs a warning — set this for anything real.
ONELIFE_SECRET_KEY=

# Comma-separated emails allowed to use the hidden admin export/import UI.
# The logged-in account's email must be in this list to see the ⚙ admin panel.
ONELIFE_ADMIN_EMAILS=

# Optional — enables real Spotify track resolution (search, 30s previews, album art)
# AND the Web Playback SDK connect flow (full tracks; client id alone is enough
# for the SDK, secret is for server-side search). Create an app at
# developer.spotify.com and register http://localhost:5173/ as a redirect URI.
# Without these, the game still suggests fitting tracks as text (no playback).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# The exact redirect URI you registered in the Spotify dashboard. Must match the
# browser origin where you open the game. Examples:
#   http://localhost:5173/      (if Spotify accepts localhost)
#   http://127.0.0.1:5173/      (if it requires a loopback IP — then open the game at 127.0.0.1)
# Leave empty to use the app's own origin + path automatically.
SPOTIFY_REDIRECT_URI=

# Optional — real location images. Pick a provider:
#   IMAGE_PROVIDER=pollinations  free + keyless (https://pollinations.ai) — no key needed.
#   IMAGE_PROVIDER=openai        OpenAI-compatible images API — needs IMAGE_API_KEY below.
# Unset / neither configured -> procedural SVG banner per theme.
# After enabling, warm the cache: docker compose run --rm api python -m app.gen_images
IMAGE_PROVIDER=openai
IMAGE_API_KEY=
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
# Pollinations options (only used when IMAGE_PROVIDER=pollinations).
POLLINATIONS_MODEL=flux
IMAGE_BANNER_SIZE=1024x384
# Optional token from auth.pollinations.ai. With it, locations that have a real
# reference photo are generated image-to-image (the real place, restyled) instead
# of text-to-image. Without it, everything is text-to-image of the named place.
POLLINATIONS_TOKEN=
POLLINATIONS_EDIT_MODEL=kontext

# Optional — Google Gemini image API key, used by the `generateMap` skill to
# generate the illustrated map backgrounds (GOOGLE_API_KEY is accepted as an
# alias). Get one at https://aistudio.google.com/apikey. Not needed to run the
# game — only when (re)generating maps.
GEMINI_API_KEY=
