# Caddy reverse proxy for OneLife. Single origin: /api/* -> FastAPI, everything else
# -> the Svelte app. The site address comes from $SITE_ADDRESS (set by whichever
# overlay is used):
#   docker-compose.lan.yml  -> SITE_ADDRESS=":80"            (plain HTTP on the LAN IP)
#   docker-compose.prod.yml -> SITE_ADDRESS="<domain>"       (auto Let's Encrypt HTTPS)
# With a domain, Caddy auto-provisions/renews the cert via ACME (needs ports 80/443
# reachable and the domain resolving here) and adds the HTTP->HTTPS redirect + HSTS.
{
	servers {
		# The Mac mini owns the router's 80/443 and terminates TLS for the public
		# domain, then proxies here. Naming it trusted lets Caddy read the real client
		# address out of its X-Forwarded-For (and honour its X-Forwarded-Proto: https)
		# instead of seeing every visitor as the Mac. Nothing else is trusted, so a
		# direct client still cannot forge either header.
		trusted_proxies static 192.168.1.191/32
	}
}

{$SITE_ADDRESS} {
	encode gzip

	# Security headers for EVERY response. The API sets its own on /api/*, but the
	# web app's HTML got none — and the HTML is what actually runs code in a browser.
	# Setting them here covers both (Caddy replaces rather than appends, so the API's
	# copies don't double up).
	header {
		# We are plain HTTP here on purpose: the Mac mini terminates TLS for the public
		# domain and proxies in. The client's connection is HTTPS, so HSTS is honest —
		# and it must be sent from behind the proxy because that is where the response
		# is built. Two years, subdomains included.
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# frame-ancestors is the modern spelling; X-Frame-Options is for the browsers
		# that never learned it.
		X-Frame-Options "DENY"
		# The allow-lists are exactly what the app loads, no more:
		#   sdk.scdn.co        Spotify Web Playback SDK (script + the iframe it injects)
		#   accounts/api.spotify.com  PKCE token exchange + playback control
		#   open.spotify.com   the embedded track player
		#   huggingface.co / raw.githubusercontent.com  WebLLM weights + wasm, fetched
		#                      by the browser in LLM_PROVIDER=browser mode
		# wasm-unsafe-eval and worker-src blob: are likewise WebLLM's (it compiles wasm
		# and spawns its engine worker from a blob). Scripts stay 'self' — no inline.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://sdk.scdn.co; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://accounts.spotify.com https://api.spotify.com https://*.spotify.com https://huggingface.co https://*.huggingface.co https://*.hf.co https://raw.githubusercontent.com; frame-src https://sdk.scdn.co https://open.spotify.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# API: keep the /api prefix intact (FastAPI routes are already /api/...).
	handle /api/* {
		reverse_proxy api:8000 {
			# Overwrite (not append) X-Forwarded-For with the client address Caddy
			# resolves, so a client cannot forge it to dodge the per-IP rate limiter.
			# client_ip is the real visitor: the peer address, except behind a
			# trusted_proxies hop, where it is read from that hop's X-Forwarded-For.
			# Using remote_host here would key every visitor to the Mac's address.
			# The API trusts this header only from Caddy (TRUSTED_PROXY_CIDRS).
			header_up X-Forwarded-For {http.request.client_ip}
		}
	}

	# Content assets (map background, icons, banners) are served by the API from the
	# mounted game-data dir at /content-static/* — route them to the API too, or every
	# image 404s on the deployed site (the web server has no such path).
	handle /content-static/* {
		reverse_proxy api:8000
	}

	# NOTE: the FastAPI auto-docs (/docs, /redoc, /openapi.json) are deliberately NOT
	# routed. They enumerate every endpoint — auth and admin included — which is free
	# reconnaissance on the open internet. The API also switches them off entirely when
	# ONELIFE_ENV=prod; this is the belt to that pair of braces. Read them locally.

	# Everything else: the production web app (vite preview serving the built bundle).
	reverse_proxy web:5173
}
